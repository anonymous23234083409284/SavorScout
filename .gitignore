# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
.env.local
backend/.env
# Any env file at all: API keys (Buffer, Google, Bing) must never reach GitHub.
.env
.env.*
*.env
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Keyword tool (scripts/research/keywords.py): its database and reports, and
# the credentials it reads. None of these belong in the repository.
scripts/research/out/
scripts/research/config.json
scripts/research/client_secret*.json
scripts/research/*service*account*.json
scripts/research/*-key.json
__pycache__/
