     "clip": 6645813
    },
    {
     "beats": 5,
     "style": "cap",
     "text": "Today is National Eating Healthy Day. *Here's how to get real protein when you eat out.*",
     "q": [
      "grilled chicken plate",
      "healthy meal restaurant",
      "healthy food plate"
     ],
     "clip": 8477264
    },
    {
     "beats": 6,
     "style": "item",
     "num": "1",
     "text": "Pick a place where protein is the main dish",
     "sub": "Shawarma plates, Korean barbecue, rotisserie chicken and poke make it easy.",
     "q": [
      "korean bbq grill",
      "shawarma plate",
      "rotisserie chicken"
     ],
     "clip": 33338733
    },
    {
     "beats": 6,
     "style": "item",
     "num": "2",
     "text": "Ask for double meat, half rice",
     "sub": "It's a common ask at bowl and burrito places. Extra meat usually costs a little more.",
     "q": [
      "burrito bowl",
      "making burrito bowl",
      "rice bowl meat"
     ],
     "clip": 7601351
    },
    {
     "beats": 6,
     "style": "item",
     "num": "3",
     "text": "Grilled, not fried",
     "sub": "It's the same protein, just leaner.",
     "q": [
      "grilled chicken",
      "chicken on grill",
      "grilling meat"
     ],
     "clip": 30044486
    },
    {
     "beats": 6,
     "style": "item",
     "num": "4",
     "text": "Watch out for pasta with a little chicken",
     "sub": "It fills you up without much protein.",
     "q": [
      "chicken pasta",
      "pasta plate",
      "creamy pasta"
     ],
     "clip": 34317032
    },
    {
     "beats": 6,
     "style": "cap",
     "text": "Vegetarian? *Tofu, lentils, beans, eggs and paneer all count.*",
     "q": [
      "tofu",
      "lentils",
      "paneer"
     ],
     "clip": 36994146
    },
    {
     "beats": 6,
     "style": "end",
     "text": "Save this for your next meal out",
     "sub": "What's your go-to high-protein order?",
     "reuse": 0
    }
