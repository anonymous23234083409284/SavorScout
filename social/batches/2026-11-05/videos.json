  {
   "id": "sushi-tell",
   "mood": "cozy",
   "source": "https://www.savorscout.net/food/sushi",
   "scenes": [
    {
     "beats": 5,
     "style": "hook",
     "text": "How to tell *good sushi* from *bad sushi* before you order",
     "q": [
      "sushi chef nigiri",
      "sushi close up",
      "nigiri sushi"
     ],
     "clip": 31561018
    },
    {
     "beats": 4,
     "style": "cap",
     "text": "Start with the rice, *not the fish.*",
     "q": [
      "sushi rice",
      "making sushi rice",
      "sushi chef rice"
     ],
     "clip": 8908333
    },
    {
     "beats": 6,
     "style": "item",
     "num": "1",
     "text": "Rice that's barely warm",
     "sub": "It should be just warm and lightly seasoned. Cold, packed rice means sushi made on an assembly line.",
     "q": [
      "sushi chef making nigiri",
      "forming nigiri",
      "sushi chef hands"
     ],
     "clip": 8908337
    },
    {
     "beats": 6,
     "style": "item",
     "num": "2",
     "text": "A short menu that changes",
     "sub": "Sixty kinds of fish all year usually means frozen. A dozen that change means they buy what's good.",
     "q": [
      "slicing raw fish",
      "sashimi knife",
      "cutting fish"
     ],
     "clip": 36997896
    },
    {
     "beats": 6,
     "style": "item",
     "num": "3",
     "text": "More nigiri than rolls",
     "sub": "Nigiri is fish on rice, where the skill shows. A menu of rolls with three sauces is selling something else.",
     "q": [
      "sushi rolls sauce",
      "sushi roll",
      "nigiri plate"
     ],
     "clip": 3298020
    },
    {
     "beats": 6,
     "style": "item",
     "num": "4",
     "text": "A chef you can talk to",
     "sub": "At a counter, you can ask what's good today and get a real answer.",
     "q": [
      "sushi counter",
      "sushi bar chef",
      "sushi restaurant counter"
     ],
     "clip": 8908216
    },
    {
     "beats": 6,
     "style": "cap",
     "text": "And if the wasabi is already under the fish, *you're somewhere serious.*",
     "q": [
      "wasabi sushi",
      "sushi chef wasabi",
      "nigiri close up"
     ],
     "clip": 8908217
    },
    {
     "beats": 6,
     "style": "end",
     "text": "Save this for your next sushi night",
     "sub": "Follow for more food that's worth it.",
     "reuse": 0
    }
   ],
   "track": "lofi-116"
  },
