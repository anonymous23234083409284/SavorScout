     "text": "Start with *the crust.*",
     "q": [
      "pizza crust close up",
      "pizza out of oven",
      "wood fired pizza"
     ]
    },
    {
     "beats": 6,
     "style": "item",
     "num": "1",
     "text": "Dark blisters on the edge",
     "sub": "Charred spots on the rim mean a very hot oven. An even, pale crust usually means a conveyor oven.",
     "q": [
      "neapolitan pizza crust",
      "wood fired pizza oven",
      "charred pizza crust"
     ]
    },
    {
     "beats": 6,
     "style": "item",
     "num": "2",
     "text": "Dough made days ahead",
     "sub": "Long-fermented dough tastes like bread and tears open with big holes. Places that mention 48- or 72-hour dough mean it.",
     "q": [
      "pizza dough stretching",
      "kneading pizza dough",
      "pizza dough balls"
     ]
    },
    {
     "beats": 6,
     "style": "item",
     "num": "3",
     "text": "Three toppings, not nine",
     "sub": "Too many toppings steam the base and make it soggy.",
     "q": [
      "margherita pizza",
      "adding toppings pizza",
      "basil on pizza"
     ]
    },
    {
     "beats": 6,
     "style": "item",
     "num": "4",
     "text": "Sauce that tastes like tomato",
     "sub": "Bright and simple. Thick, sweet sauce is covering for cheap tomatoes.",
     "q": [
      "spreading tomato sauce pizza",
      "tomato sauce dough",
      "fresh tomatoes basil"
     ]
    },
    {
     "beats": 6,
     "style": "cap",
     "text": "Lift a slice. *If it leaves a pool of grease,* the cheese is cheap.",
     "q": [
      "lifting pizza slice",
