{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/eat/:slug/",
      "destination": "/eat/:slug",
      "permanent": true
    },
    {
      "source": "/type/:slug/",
      "destination": "/type/:slug",
      "permanent": true
    },
    {
      "source": "/what-to-eat/:slug/",
      "destination": "/what-to-eat/:slug",
      "permanent": true
    },
    {
      "source": "/food/:slug/",
      "destination": "/food/:slug",
      "permanent": true
    },
    {
      "source": "/diet/:slug/",
      "destination": "/diet/:slug",
      "permanent": true
    },
    {
      "source": "/campus/:slug/",
      "destination": "/campus/:slug",
      "permanent": true
    },
    {
      "source": "/campus/purdue-university-global",
      "destination": "/campus/in",
      "permanent": true
    },
    {
      "source": "/campus/university-of-the-people",
      "destination": "/campus/ca",
      "permanent": true
    },
    {
      "source": "/campus/western-governors-university",
      "destination": "/campus/ut",
      "permanent": true
    },
    {
      "source": "/campus/excelsior-university",
      "destination": "/campus/ny",
      "permanent": true
    },
    {
      "source": "/campus/indiana-wesleyan-university-national-and-global",
      "destination": "/campus/in",
      "permanent": true
    },
    {
      "source": "/campus/national-university",
      "destination": "/campus/ca",
      "permanent": true
    },
    {
      "source": "/campus/colorado-state-university-global",
      "destination": "/campus/co",
      "permanent": true
    },
    {
      "source": "/campus/empire-state-university",
      "destination": "/campus/ny",
      "permanent": true
    },
    {
      "source": "/campus/thomas-edison-state-university",
      "destination": "/campus/nj",
      "permanent": true
    },
    {
      "source": "/campus/university-of-massachusetts-global",
      "destination": "/campus/ca",
      "permanent": true
    },
    {
      "source": "/about/:slug/",
      "destination": "/about/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/r/:code",
      "destination": "/room.html"
    },
    {
      "source": "/eat",
      "destination": "/eat/index.html"
    },
    {
      "source": "/eat/",
      "destination": "/eat/index.html"
    },
    {
      "source": "/eat/:slug",
      "destination": "/eat/:slug.html"
    },
    {
      "source": "/type",
      "destination": "/type/index.html"
    },
    {
      "source": "/type/",
      "destination": "/type/index.html"
    },
    {
      "source": "/type/:slug",
      "destination": "/type/:slug.html"
    },
    {
      "source": "/what-to-eat",
      "destination": "/what-to-eat/index.html"
    },
    {
      "source": "/what-to-eat/",
      "destination": "/what-to-eat/index.html"
    },
    {
      "source": "/what-to-eat/:slug",
      "destination": "/what-to-eat/:slug.html"
    },
    {
      "source": "/food",
      "destination": "/food/index.html"
    },
    {
      "source": "/food/",
      "destination": "/food/index.html"
    },
    {
      "source": "/food/:slug",
      "destination": "/food/:slug.html"
    },
    {
      "source": "/diet",
      "destination": "/diet/index.html"
    },
    {
      "source": "/diet/",
      "destination": "/diet/index.html"
    },
    {
      "source": "/diet/:slug",
      "destination": "/diet/:slug.html"
    },
    {
      "source": "/campus",
      "destination": "/campus/index.html"
    },
    {
      "source": "/campus/",
      "destination": "/campus/index.html"
    },
    {
      "source": "/campus/:slug",
      "destination": "/campus/:slug.html"
    },
    {
      "source": "/about/:slug",
      "destination": "/about/:slug.html"
    },
    {
      "source": "/((?!static/|eat/|type/|what-to-eat/|food/|diet/|campus/|about/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
