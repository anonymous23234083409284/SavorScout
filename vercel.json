{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon\\.ico|icon-\\d+\\.png|apple-touch-icon\\.png|og-card\\.jpg|og-room\\.jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/eat/:slug/",
      "destination": "/eat/:slug",
      "permanent": true
    },
    {
      "source": "/type/:slug/",
      "destination": "/type/:slug",
      "permanent": true
    },
    {
      "source": "/what-to-eat/:slug/",
      "destination": "/what-to-eat/:slug",
      "permanent": true
    },
    {
      "source": "/food/:slug/",
      "destination": "/food/:slug",
      "permanent": true
    },
    {
      "source": "/diet/:slug/",
      "destination": "/diet/:slug",
      "permanent": true
    },
    {
      "source": "/campus/:slug/",
      "destination": "/campus/:slug",
      "permanent": true
    },
    {
      "source": "/about/:slug/",
      "destination": "/about/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/r/:code",
      "destination": "/room.html"
    },
    {
      "source": "/eat",
      "destination": "/eat/index.html"
    },
    {
      "source": "/eat/",
      "destination": "/eat/index.html"
    },
    {
      "source": "/eat/:slug",
      "destination": "/eat/:slug.html"
    },
    {
      "source": "/type",
      "destination": "/type/index.html"
    },
    {
      "source": "/type/",
      "destination": "/type/index.html"
    },
    {
      "source": "/type/:slug",
      "destination": "/type/:slug.html"
    },
    {
      "source": "/what-to-eat",
      "destination": "/what-to-eat/index.html"
    },
    {
      "source": "/what-to-eat/",
      "destination": "/what-to-eat/index.html"
    },
    {
      "source": "/what-to-eat/:slug",
      "destination": "/what-to-eat/:slug.html"
    },
    {
      "source": "/food",
      "destination": "/food/index.html"
    },
    {
      "source": "/food/",
      "destination": "/food/index.html"
    },
    {
      "source": "/food/:slug",
      "destination": "/food/:slug.html"
    },
    {
      "source": "/diet",
      "destination": "/diet/index.html"
    },
    {
      "source": "/diet/",
      "destination": "/diet/index.html"
    },
    {
      "source": "/diet/:slug",
      "destination": "/diet/:slug.html"
    },
    {
      "source": "/campus",
      "destination": "/campus/index.html"
    },
    {
      "source": "/campus/",
      "destination": "/campus/index.html"
    },
    {
      "source": "/campus/:slug",
      "destination": "/campus/:slug.html"
    },
    {
      "source": "/about/:slug",
      "destination": "/about/:slug.html"
    },
    {
      "source": "/((?!static/|eat/|type/|what-to-eat/|food/|diet/|campus/|about/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
