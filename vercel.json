{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/r/:code",
      "destination": "/room.html"
    },
    {
      "source": "/eat",
      "destination": "/eat/index.html"
    },
    {
      "source": "/eat/",
      "destination": "/eat/index.html"
    },
    {
      "source": "/eat/:slug",
      "destination": "/eat/:slug.html"
    },
    {
      "source": "/type",
      "destination": "/type/index.html"
    },
    {
      "source": "/type/",
      "destination": "/type/index.html"
    },
    {
      "source": "/type/:slug",
      "destination": "/type/:slug.html"
    },
    {
      "source": "/((?!static/|eat/|type/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
